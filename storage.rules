rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin() { return request.auth!=null && request.auth.token.get('admin',false)==true; }
  match /productImages/{productId}/{fileName} {
   allow read: if true;
   allow write: if admin() && (request.resource==null || (request.resource.size<5*1024*1024 && request.resource.contentType in ['image/jpeg','image/png','image/webp']));
  }
  match /{allPaths=**} {
   allow read, write: if false;
  }
 }
}

