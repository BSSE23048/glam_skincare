rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.get('admin',false) == true; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function text(v,n) { return v is string && v.size() <= n; }
  function config() {
   return get(/databases/$(database)/documents/settings/store).data;
  }
  function customer(c) {
   return c.keys().hasOnly(['name','email','phone','whatsapp','address','apartment','area','city','province','postalCode','instructions'])
    && text(c.name,100) && c.name.size()>0 && c.email == request.auth.token.email
    && c.phone.matches('^(\\+92|0092|0)?3[0-9]{9}$') && text(c.whatsapp,20)
    && text(c.address,300) && c.address.size()>0 && text(c.apartment,100) && text(c.area,100) && c.area.size()>0
    && text(c.city,100) && c.city.size()>0 && c.province in ['Punjab','Sindh','Khyber Pakhtunkhwa','Balochistan','Islamabad Capital Territory','Azad Jammu and Kashmir','Gilgit-Baltistan']
    && text(c.postalCode,10) && text(c.instructions,600);
  }
  function line(l) {
   let s = get(/databases/$(database)/documents/skus/$(l.sku)).data;
   return s.active == true && l.quantity is int && l.quantity>=1 && l.quantity<=10 && l.quantity<=s.stock
    && l == { 'sku': l.sku, 'productId': s.productId, 'variantId': s.variantId, 'name': s.name, 'variantName': s.variantName, 'image': s.image, 'unitPrice': s.price, 'quantity': l.quantity, 'lineTotal': s.price*l.quantity };
  }
  function lineAt(a,i) { return a.size()<=i || line(a[i]); }
  function amount(a,i) { return a.size()>i ? a[i].lineTotal : 0; }
  function distinct(a) {
   return [a[0].sku, a.size()>1 ? a[1].sku : null, a.size()>2 ? a[2].sku : null, a.size()>3 ? a[3].sku : null, a.size()>4 ? a[4].sku : null].toSet().size() == (a.size()==5 ? 5 : a.size()+1);
  }
  function payment(o,id) {
   return (o.paymentMethod=='cod' && o.paymentStatus=='cod_pending' && o.orderStatus=='pending')
    || (o.paymentMethod=='manual_online_payment' && config().bank.enabled==true && o.paymentStatus=='awaiting_verification' && o.orderStatus=='payment_verification');
  }
  function order(o,id) {
   let settings = config();
   let items = o.items;
   let subtotal = amount(items,0)+amount(items,1)+amount(items,2)+amount(items,3)+amount(items,4);
   let shipping = subtotal>=settings.shipping.freeAbove ? 0 : settings.shipping.fee;
   let checkout = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/limits/checkout).data;
   return id.matches('^GS-[0-9A-Z]{4,16}$') && customer(o.customer)
    && items is list && items.size()>=1 && items.size()<=5 && distinct(items)
    && lineAt(items,0) && lineAt(items,1) && lineAt(items,2) && lineAt(items,3) && lineAt(items,4)
    && payment(o,id)
    && o == { 'orderNumber': id, 'userId': request.auth.uid, 'customer': o.customer, 'items': items,
      'subtotal': subtotal, 'shipping': shipping, 'total': subtotal+shipping,
      'paymentMethod': o.paymentMethod, 'paymentStatus': o.paymentStatus, 'orderStatus': o.orderStatus,
      'createdAt': request.time, 'updatedAt': request.time, 'inventoryReserved': false,
      'verifiedAt': null, 'verifiedBy': '', 'rejectionReason': '', 'trackingNumber': '', 'history': [] }
    && checkout.orderId==id && checkout.lastOrderAt==request.time;
  }
  match /users/{uid} {
   allow read: if owner(uid) || admin();
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['uid','displayName','email','phone','whatsapp','defaultShipping','createdAt','updatedAt']) && request.resource.data.uid==uid && request.resource.data.email==request.auth.token.email && text(request.resource.data.displayName,100) && text(request.resource.data.phone,20) && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','whatsapp','defaultShipping','updatedAt']) && text(request.resource.data.displayName,100) && text(request.resource.data.phone,20) && request.resource.data.updatedAt==request.time;
   match /addresses/{id} {
    allow read,delete: if owner(uid);
    allow create,update: if owner(uid) && request.resource.data.keys().hasOnly(['label','customer','updatedAt']) && text(request.resource.data.label,60) && customer(request.resource.data.customer) && request.resource.data.updatedAt==request.time;
   }
   match /limits/{key} {
    allow read: if owner(uid);
    allow create,update: if owner(uid) && key=='checkout' && request.resource.data.keys().hasOnly(['lastOrderAt','orderId']) && request.resource.data.lastOrderAt==request.time
     && (!exists(/databases/$(database)/documents/users/$(uid)/limits/checkout) || request.time>resource.data.lastOrderAt+duration.value(20,'s'))
     && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId==uid
     && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.createdAt==request.time;
   }
  }
  match /products/{id} { allow read: if admin() || resource.data.active==true; allow create,update: if admin() && !request.resource.data.keys().hasAny(['costPrice','packagingCost','handlingCost']); allow delete: if admin(); }
  match /productSlugs/{id} { allow read, write: if admin(); }
  match /productCosts/{id} { allow read, write: if admin(); }
  match /skus/{id} { allow read: if admin() || resource.data.active==true; allow create,update: if admin() && !request.resource.data.keys().hasAny(['costPrice','packagingCost','handlingCost']) && request.resource.data.stock is int && request.resource.data.stock>=0; allow delete: if admin(); }
  match /categories/{id} { allow read: if true; allow write: if admin(); }
  match /settings/{id} { allow read: if id=='store'; allow write: if admin(); }
  match /siteContent/{id} { allow read: if true; allow write: if admin(); }
  match /orders/{id} {
   allow get: if admin() || (signedIn() && resource == null) || owner(resource.data.userId);
   allow list: if admin() || owner(resource.data.userId);
   allow create: if signedIn() && order(request.resource.data,id);
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus','paymentStatus','inventoryReserved','verifiedAt','verifiedBy','rejectionReason','trackingNumber','updatedAt','history']) && request.resource.data.updatedAt==request.time && request.resource.data.history.size()<=40;
   allow delete: if false;
  }
  match /orderNotes/{id} { allow read,write: if admin(); }
  match /reviews/{id} {
   function purchased(o,p) { return o.items[0].productId==p || (o.items.size()>1 && o.items[1].productId==p) || (o.items.size()>2 && o.items[2].productId==p) || (o.items.size()>3 && o.items[3].productId==p) || (o.items.size()>4 && o.items[4].productId==p); }
   allow read: if admin() || resource.data.status=='approved' || owner(resource.data.userId);
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['productId','orderId','userId','author','rating','body','status','verifiedPurchase','createdAt']) && request.resource.data.userId==request.auth.uid && id==request.resource.data.orderId+'_'+request.resource.data.productId
    && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId==request.auth.uid && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderStatus=='delivered'
    && purchased(get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data,request.resource.data.productId)
    && request.resource.data.status=='pending' && request.resource.data.verifiedPurchase==true && request.resource.data.rating is int && request.resource.data.rating>=1 && request.resource.data.rating<=5 && text(request.resource.data.author,100) && text(request.resource.data.body,2000) && request.resource.data.body.size()>0 && request.resource.data.createdAt==request.time;
   allow update,delete: if admin();
  }
  match /newsletterSubscribers/{uid} {
   allow read: if owner(uid) || admin();
   allow create,update: if owner(uid) && request.resource.data.keys().hasOnly(['email','consent','updatedAt']) && request.resource.data.email==request.auth.token.email && request.resource.data.consent is bool && request.resource.data.updatedAt==request.time;
   allow delete: if owner(uid) || admin();
  }
  match /contactMessages/{uid} {
   allow read: if owner(uid) || admin();
   allow create,update: if owner(uid) && request.resource.data.keys().hasOnly(['userId','name','email','topic','message','updatedAt']) && request.resource.data.userId==uid && request.resource.data.email==request.auth.token.email && text(request.resource.data.name,100) && text(request.resource.data.topic,100) && text(request.resource.data.message,2000) && request.resource.data.message.size()>0 && request.resource.data.updatedAt==request.time;
   allow delete: if admin();
  }
 }
}
