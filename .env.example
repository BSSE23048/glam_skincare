# Glam Skincare — Firebase Web Configuration
# Copy this file to .env.local and fill in your values from Firebase Console.
# Location in Firebase Console: Project Settings > General > Your apps > Web app > SDK setup and configuration

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_SITE_URL=https://glamskincare.pk
