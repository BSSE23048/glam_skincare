    "seed:local": "node scripts/seed.mjs",
    "test:rules": "node --test tests/rules.test.mjs",
    "test:backend": "playwright test tests/backend.spec.ts"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
